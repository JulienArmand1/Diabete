# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit it, and never put real values here.

# ── LibreLinkUp account ───────────────────────────────────────
LIBRELINKUP_EMAIL=you@example.com
LIBRELINKUP_PASSWORD=your-password
LIBRELINKUP_COUNTRY=CA

# ── ntfy ──────────────────────────────────────────────────────
# The topic name is the only thing protecting your notifications:
# anyone who knows it can read them. Pick something unguessable.
NTFY_TOPIC=choose-an-unguessable-topic
NTFY_URL=https://ntfy.sh

# ── healthchecks.io (optional watchdog) ───────────────────────
# Leave blank to disable the watchdog.
HEALTHCHECKS_UUID=

# ── This machine's name, shown in notifications ───────────────
MACHINE_NAME=PC-A